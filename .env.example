# =====================================================================
#  AI Builders Club - NetworkEvolution - Session 1
#  Copy this file to ".env" (same folder) and fill in YOUR values:
#      cp .env.example .env
#  .env holds secrets -> NEVER share it, NEVER commit it to git.
# =====================================================================

# Your Gemini API key from https://aistudio.google.com/apikey
# (the google-genai SDK finds this variable name automatically)
GEMINI_API_KEY=paste-your-key-here

# Login for BOTH switches (lab default: admin / admin)
DEVICE_USERNAME=admin
DEVICE_PASSWORD=admin

# Switch 1 and Switch 2 (your lab IPs)
SW1_HOST=172.20.20.11
SW2_HOST=172.20.20.12

# OPTIONAL - SSH port. Leave it out and the scripts use 22 (default).
# SW1_PORT=22
# SW2_PORT=22
